<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>transfer-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>transfer-platform</name>
  <description>Virement interne compte courant / livret : saga orchestrée, outbox, inbox</description>

  <modules>
    <module>payment-service</module>
    <module>account-service</module>
    <module>savings-service</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.11.0</spotless.version>
    <!-- 1.37.0 échoue sous Spotless 3.11.0 (InvocationTargetException) : rester en 1.36.x -->
    <google-java-format.version>1.36.1</google-java-format.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Hors BOM Spring Boot : version fixée ici -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Formatage : spotless:apply en local (hook), spotless:check dans verify (CI) -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Tests d'intégration *IT pendant verify (exécutions héritées du parent Spring Boot) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
